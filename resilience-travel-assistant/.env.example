# === 韌性出行助手 環境變數範例 ===
# 複製為 .env.local 後填寫。切勿提交任何真實金鑰（.env*.local 已被 .gitignore 忽略）。

# 服務版本（顯示於 /api/health 與頁尾）
APP_VERSION=0.1.0

# 實時資料逾時（毫秒）。逾時後依序回退至 cached → fixture。
LIVE_DATA_TIMEOUT_MS=2500

# 故障注入開關（僅供演示與自動化測試使用）。
# 1 = 允許 POST /api/decision 帶 { "faultInjection": "..." } 觸發錯誤情境。
# 正式對外版本請保持 0。
ALLOW_FAULT_INJECTION=0

# --- 成員 B：香港天文台開放數據（未填寫時系統自動使用 fixture）---
# 可填官方 endpoint：https://data.weather.gov.hk/weatherAPI/opendata/weather.php
HKO_OPEN_DATA_BASE_URL=
HKO_WEATHER_WARNING_URL=

# --- 運輸署官方 XML 公告（可選啟用；不推論路線延誤）---
TD_SPECIAL_TRAFFIC_NEWS_URL=
# 舊版保留的變數，官方公開 XML 不需要 API Key；目前不使用。
TD_SPECIAL_TRAFFIC_NEWS_API_KEY=

# 港鐵坑口／北角／鰂魚涌下一班抵站預測。只補充資料，不替換全程時間估算。
MTR_NEXT_TRAIN_ENABLED=0
# TD 可填官方 XML：https://www.td.gov.hk/en/special_news/trafficnews.xml
# 只提取走廊相關公告，不推論無消息＝服務正常。
# 城巴 690S 明德邨起站 ETA 由 transportTimeClient.citybus() 獨立取得，待 A 確認 R2 映射。
