{
  "name": "resilience-travel-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "韌性出行助手 — 公共交通通勤與惡劣天氣下的出行可靠性決策層（演示原型）",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:static": "node scripts/build-static.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "vitest run --reporter=verbose src/test/freeze-smoke.test.ts",
    "fixtures:update": "UPDATE_FIXTURES=1 vitest run src/test/golden.test.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "next": "15.5.27",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.27",
    "postcss": "^8.4.49",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
